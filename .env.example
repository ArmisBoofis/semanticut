# Copy to `.env` and adjust for local dev. Do not commit `.env`.
# Used by Docker Compose `db` and (later) API connection string from the same names.

POSTGRES_USER=semanticut
POSTGRES_PASSWORD=semanticut_dev_change_me
POSTGRES_DB=semanticut

# Host port mapping (db listens on 5432 inside the container).
POSTGRES_PORT=5432

# API (Story 1.2). The `api` container receives the same POSTGRES_* as `db` plus POSTGRES_HOST=db
# (set in docker-compose.yml). The app builds DATABASE_URL with URL-safe password encoding.
# Optional overrides:
API_PORT=8000

# Web / Next.js (Story 1.3). `web` publishes WEB_PORT; server-side fetches use API_INTERNAL_URL.
WEB_PORT=3000
API_INTERNAL_URL=http://api:8000
# Local Next dev on host (outside Docker): use e.g. API_INTERNAL_URL=http://127.0.0.1:8000
# POSTGRES_HOST=localhost
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/semanticut
# DB_CONNECT_TIMEOUT=5
# DB_COMMAND_TIMEOUT=5
# SKIP_DB_STARTUP=1   # tests only — skip startup DB check / engine dispose (do not use in production)

# Ingestion worker (Story 2.4). Required for transcription/embeddings; optional on `api` (status-only).
# MISTRAL_API_KEY=
# Mistral models (defaults match product brief / architecture).
# MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
# MISTRAL_EMBEDDING_MODEL=mistral-embed
# Root used when `storage_path` is relative; absolute paths are used as-is.
# VIDEO_STORAGE_ROOT=/data/videos
# Host folder mounted into `api` (read-write) and `worker` (read-only) at /data/videos (see docker-compose.yml).
# VIDEO_STORAGE_HOST_PATH=./data/videos
# Optional max size for multipart admin uploads (bytes; default 524288000).
# VIDEO_UPLOAD_MAX_BYTES=524288000
# Fragmentation threshold in seconds for long-video ingestion (strictly greater than this value triggers fragmentation).
# INGESTION_FRAGMENT_MAX_SECONDS=1800

# Search / macro indexing (Story 3.3). Defaults match backend `Settings`.
# TRANSCRIPT_MACRO_TARGET_MODE=words
# TRANSCRIPT_MACRO_TARGET_WORDS=280
# TRANSCRIPT_MACRO_TARGET_CHARS=1600
# SEARCH_MACRO_TOP_K_MAX=5
# SEARCH_MACRO_TOP_K=10
# SEARCH_MACRO_MAX_COSINE_DISTANCE=0.95
# SEARCH_MACRO_GAP_FROM_BEST=0.18
# SEARCH_RRF_K=60
# MISTRAL_ANCHOR_MODEL=mistral-small-latest
# MISTRAL_ANCHOR_MAX_TOKENS=1024
# Legacy alias still accepted: SEARCH_COARSE_TOP_N (same as SEARCH_MACRO_TOP_K_MAX).
